# DropAlert — variabili d'ambiente (copia in .env e compila).
#
# Regola del progetto: ogni variabile opzionale ha un default dichiarato, e il
# sito funziona senza NESSUNA di queste chiavi (fonte BetExplorer inclusa).
# Dove manca una chiave, il sito non stima: la dichiara.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 17+). In produzione: la stringa di Neon su Vercel.
# In locale: `postgres://dropalert@127.0.0.1:5432/dropalert` dopo
# initdb + CREATE DATABASE (vedi README §Database locale).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://dropalert@127.0.0.1:5432/dropalert

# Per i dry-run di migrazione (scripts rehearsal): un endpoint separato,
# mai il database di produzione.
# PRODUCTION_DATABASE_URL=
# MIGRATION_TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Protezione dei job (PRODUZIONE: obbligatoria, altrimenti POST
# /api/jobs/analyze risponde 401 e il cron resta chiuso).
# ---------------------------------------------------------------------------
# JOBS_TOKEN=
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Scheduler interno (opzionale: il progetto non ha processi long-lived,
# la ripetizione è di norma delegata a cron esterno).
# SCHEDULER_ENABLED=true  →  il runner schedulato parte nel server.
# ---------------------------------------------------------------------------
# SCHEDULER_ENABLED=
# COLLECT_INTERVAL_MINUTES=45     # intervallo minimo fra due raccolte (min 5)
# COLLECT_HORIZON_HOURS=72        # quanto avanti guardare nel calendario
# COLLECT_MAX_FIXTURES=25         # tetto di partite per giro
# COLLECT_WITH_RESULTS=true       # aggiorna anche i risultati finali

# ---------------------------------------------------------------------------
# BetExplorer — fonte principale (attiva di default, nessuna chiave).
# ---------------------------------------------------------------------------
# BETEXPLORER_ENABLED=true        # spegne la fonte principale
# BETEXPLORER_RPM=12              # richieste al minuto
# BETEXPLORER_MIN_INTERVAL_MS=4000
# BETEXPLORER_LISTING_TTL_MS=30000

# ---------------------------------------------------------------------------
# Calendario radar (football-data.org, piano gratuito: 10 req/min, TIER_ONE).
# Senza chiave /domani dichiara «calendario non disponibile: chiave non
# configurata» — non è un errore.
# ---------------------------------------------------------------------------
# FOOTBALL_DATA_API_KEY=

# ---------------------------------------------------------------------------
# The Odds API (opzionale, SPENTA di default).
# È la linea per-bookmaker che il sito usa per la conferma sharp, dietro il
# cablaggio del ciclo (doppio flag qui sotto). Budget dichiarato dal codice:
# 490 crediti/mese, 14/giorno, 1 lettura/partita/giorno.
# ---------------------------------------------------------------------------
# ODDS_API_ENABLED=false
# ODDS_API_KEY=                   # alias riconosciuti: THE_ODDS_API_KEY
# ODDS_ADAPTER_IMPLEMENTED=false  # lo smoke test live lo accende (vedi docs/SMOKE-THE-ODDS-API.md)

# Cablaggio per-bookmaker nel ciclo di raccolta: i due flag SI ACCENDONO
# INSIEME, mai uno solo (docs/STUDIO-CABLAGGIO-ODDS.md §4.7).
# ODDS_WIRE_COLLECT=false
# DROP_EXCLUDE_CONSENSUS_BOOKS=false

# ---------------------------------------------------------------------------
# OddsPapi (opzionale) — dati storici per backtesting.
# ---------------------------------------------------------------------------
# ODDS_PAPI_KEY=

# ---------------------------------------------------------------------------
# SharpAPI (opzionale) — adapter STANDALONE: interrogabile dai script,
# NON cablato nel ciclo né nelle pagine (vedi GUIDA-OPERATIVA.md).
# ---------------------------------------------------------------------------
# SHARP_API_KEY=
# SHARP_API_BASE_URL=https://sharpapi.io

# Esiti secondari (TheSportsDB v1): senza chiave usa la chiave pubblica di
# test "3" (copertura parziale, dichiarata).
# SPORTSDB_API_KEY=

# ---------------------------------------------------------------------------
# Notifiche web push (VAPID). Senza chiavi la fase si dichiara
# configured:false e il giro di raccolta non dipende dalle notifiche.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY serve al client per la sottoscrizione.
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Contesto 360° (opzionale). Senza LLM_API_KEY il pannello dichiara
# «non disponibile — chiave non configurata». Cache 24h/partita, tetto
# giornaliero di 50 chiamate con hard-stop.
# ---------------------------------------------------------------------------
# LLM_API_KEY=
# TAVILY_API_KEY=
# RSS_FEEDS=                      # feed RSS pubblici, URL separati da virgola (max 3)
# NEWS_FEEDS_IT=
# NEWS_FEEDS_EN=

# ---------------------------------------------------------------------------
# Identità pubblica (opzionale). Default: https://dropalert-next.vercel.app.
# NEXT_PUBLIC_SITE_URL / VERCEL_PROJECT_PRODUCTION_URL in produzione.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=
# DROPALERT_BASE_URL=
