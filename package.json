{
  "name": "dropalert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/lib/drop/__tests__/engine.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "validate": "npm run typegen && npm run typecheck && npm run test && npm run build",
    "test:quant": "tsx src/lib/quant/__tests__/quant.test.ts",
    "test:pipeline": "tsx --env-file-if-exists=.env src/lib/pipeline/__tests__/pipeline.test.ts",
    "test:all": "npm run test && npm run test:quant && npm run test:view && npm run test:value-lines && npm run test:filters && npm run test:timeline && npm run test:plain && npm run test:why && npm run test:locale && npm run test:analysis && npm run test:odds-budget && npm run test:watchlist && npm run test:feed && npm run test:calendar && npm run test:push && npm run test:gate && npm run test:providers && npm run test:betexplorer && npm run test:line-shape && npm run test:coverage && npm run test:cov-view && npm run test:scheduler && npm run test:settle && npm run test:shape && npm run test:context && npm run test:news && npm run test:backoff && npm run test:tools && npm run test:client",
    "test:coverage": "tsx src/lib/cov/__tests__/coverage.test.ts",
    "report:coverage": "tsx --env-file=.env src/scripts/run-coverage.ts",
    "job:analyze": "tsx --env-file-if-exists=.env src/scripts/run-analyze.ts",
    "test:providers": "tsx src/lib/providers/__tests__/providers.test.ts",
    "job:collect": "bash scripts/cycle.sh",
    "job:verify-results": "tsx --env-file-if-exists=.env src/scripts/verify-results.ts",
    "job:shape": "tsx --env-file-if-exists=.env src/scripts/build-shape-features.ts",
    "test:betexplorer": "tsx src/lib/providers/__tests__/betexplorer.test.ts",
    "test:view": "tsx src/lib/repo/__tests__/view.test.ts",
    "test:timeline": "tsx src/lib/view/__tests__/timeline.test.ts",
    "test:plain": "tsx src/lib/view/__tests__/plain.test.ts",
    "test:locale": "tsx src/lib/context/__tests__/locale-search.test.ts",
    "test:why": "tsx src/lib/context/__tests__/why.test.ts",
    "test:gate": "tsx src/lib/pipeline/__tests__/gate.test.ts",
    "test:push": "tsx src/lib/push/__tests__/push.test.ts",
    "test:calendar": "tsx src/lib/calendar/__tests__/calendar.test.ts",
    "test:feed": "tsx src/lib/view/__tests__/feed.test.ts",
    "test:watchlist": "tsx src/lib/view/__tests__/watchlist.test.ts",
    "test:odds-budget": "tsx src/lib/providers/optional/__tests__/odds-budget.test.ts",
    "test:analysis": "tsx src/lib/context/__tests__/analysis.test.ts",
    "test:cov-view": "tsx src/lib/cov/__tests__/view.test.ts",
    "test:scheduler": "tsx --env-file-if-exists=.env src/lib/pipeline/__tests__/scheduler.test.ts",
    "test:settle": "tsx src/lib/settle/__tests__/outcome.test.ts",
    "test:shape": "tsx src/lib/shape/__tests__/features.test.ts",
    "test:context": "tsx src/lib/context/__tests__/pure.test.ts",
    "test:news": "tsx src/lib/news/__tests__/source.test.ts",
    "test:backoff": "tsx src/lib/providers/__tests__/backoff.test.ts",
    "test:client": "tsx src/components/__tests__/watch-toggle.test.tsx && tsx src/components/__tests__/tools.test.tsx && tsx src/components/__tests__/signal-card.test.tsx && tsx src/components/__tests__/context360.test.tsx && tsx src/components/__tests__/match-summary.test.tsx",
    "test:tools": "tsx src/lib/tools/__tests__/tools.test.ts",
    "backtest:r1": "tsx scripts/backtest-r1.ts",
    "backtest:r15": "tsx scripts/backtest-r15.ts",
    "test:repo-analysis": "tsx --env-file-if-exists=.env src/lib/repo/__tests__/analysis.test.ts",
    "study:finished": "tsx scripts/study-finished.ts",
    "audit:finished": "tsx --env-file-if-exists=.env src/scripts/audit-finished.ts",
    "audit:value-bets": "tsx --env-file-if-exists=.env src/scripts/audit-value-bets.ts",
    "test:value-lines": "tsx src/lib/repo/__tests__/value-lines.test.ts",
    "test:line-shape": "tsx src/lib/providers/__tests__/line-shape.test.ts",
    "test:filters": "tsx src/lib/view/__tests__/scanner-filters.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
